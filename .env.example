APP_NAME=fieldflicks
APP_BASE_URL=http://localhost:8000
PORT=8000
ENVIRONMENT=development

# ==============================================================================
# Database Configuration
# ==============================================================================
DB_HOST=127.0.0.1
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_DATABASE=fieldflicks
DB_LOGGING=false
DB_SYNC=false

# ==============================================================================
# AWS S3 (Archive & Legacy Storage)
# ==============================================================================
AWS_S3_BUCKET_NAME=
AWS_ACCESS_KEY_ID=
AWS_REGION=
AWS_SECRET_ACCESS_KEY=

# ==============================================================================
# Media Provider Routing Flags (r2 | cloudflare | s3 | mux)
# ==============================================================================
MEDIA_STORAGE_PROVIDER=r2
MEDIA_LIVE_PROVIDER=cloudflare
MEDIA_VOD_PROVIDER=cloudflare

# ==============================================================================
# Cloudflare & R2 Media Configuration
# ==============================================================================
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_R2_ACCESS_KEY_ID=
CLOUDFLARE_R2_SECRET_ACCESS_KEY=
CLOUDFLARE_R2_BUCKET_NAME=
CLOUDFLARE_R2_ENDPOINT=
# CLOUDFLARE_R2_PUBLIC_DOMAIN=

CLOUDFLARE_STREAM_API_TOKEN=
CLOUDFLARE_STREAM_KEY_ID=
CLOUDFLARE_STREAM_PRIVATE_KEY=
# CLOUDFLARE_STREAM_WEBHOOK_SECRET=

# ==============================================================================
# Mux (Optional / Legacy)
# ==============================================================================
# MUX_TOKEN_ID=
# MUX_TOKEN_SECRET=
# MUX_SIGNING_KEY_ID=
# MUX_PRIVATE_KEY=
# MUX_WEBHOOK_SECRET=

# ==============================================================================
# Security & JWT
# ==============================================================================
JWT_SECRET=
JWT_EXPIRATION=90d
JWT_EXPIRE_TIME=90d

# ==============================================================================
# Edge / Raspberry Pi Configuration
# ==============================================================================
PI_API_KEY=
PI_EVMS_API_KEY=
PI_LIVE_API_KEY=
PI_LIVE_API_URL=
PI_RECORDINGS_API_URL=
RASPBERRY_PI_API_URL=
RPI_CLIENT_ID=

# ==============================================================================
# Third-party Integrations
# ==============================================================================
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_APP_CHECK_DEBUG_TOKEN=
FIREBASE_PRIVATE_KEY=

GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_REDIRECT_URL=
GOOGLE_OAUTH_SECRET=

RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

FAST2SMS_AUTHORIZATION=
FAST2SMS_DLT_MESSAGE_ID=
FAST2SMS_SENDER_ID=

MSG91_AUTH_KEY=
MSG91_OTP_TEMPLATE_ID=

SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SUPPORT_CONTACT_TO=

TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

FFMPEG_PATH=/opt/bin/ffmpeg