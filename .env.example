APP_NAME=fieldflicks
APP_BASE_URL=http://localhost:8000
PORT=8000
ENVIRONMENT=development

# ==============================================================================
# Database Configuration
# ==============================================================================
DB_HOST=127.0.0.1
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_DATABASE=fieldflicks
DB_LOGGING=false
DB_SYNC=false

# ==============================================================================
# AWS S3 (Archive & Legacy Storage)
# ==============================================================================
AWS_S3_BUCKET_NAME=
AWS_ACCESS_KEY_ID=
AWS_REGION=
AWS_SECRET_ACCESS_KEY=

# ==============================================================================
# Media Provider Routing Flags (r2 | cloudflare | s3 | mux)
# ==============================================================================
MEDIA_STORAGE_PROVIDER=r2
MEDIA_LIVE_PROVIDER=cloudflare
MEDIA_VOD_PROVIDER=cloudflare

# ==============================================================================
# Cloudflare & R2 Media Configuration
# ==============================================================================
# Canonical account id. Also accepted under the aliases
# CLOUDFLARE_R2_ACCOUNT_ID / CLOUDFLARE_STREAM_ACCOUNT_ID.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_R2_ACCESS_KEY_ID=
CLOUDFLARE_R2_SECRET_ACCESS_KEY=
CLOUDFLARE_R2_BUCKET_NAME=
# Optional: derived as https://<CLOUDFLARE_ACCOUNT_ID>.r2.cloudflarestorage.com
CLOUDFLARE_R2_ENDPOINT=

# Public delivery domain for the bucket (r2.dev subdomain or a custom domain).
# When set, playback URLs are plain unsigned HTTPS URLs that never expire —
# required for expo-video, which cannot satisfy the signed x-amz-checksum-mode
# header that R2 presigned GET URLs demand. Leave blank to fall back to
# presigned URLs.
CLOUDFLARE_R2_PUBLIC_URL=
# CLOUDFLARE_R2_PUBLIC_DOMAIN=

CLOUDFLARE_STREAM_API_TOKEN=
# Signed playback. Blank = unsigned manifests.
CLOUDFLARE_STREAM_KEY_ID=
CLOUDFLARE_STREAM_PRIVATE_KEY=
# Optional custom delivery host; defaults to https://videodelivery.net
# CLOUDFLARE_STREAM_CUSTOMER_SUBDOMAIN=
# CLOUDFLARE_STREAM_WEBHOOK_SECRET=

# ==============================================================================
# Mux (Optional / Legacy)
# ==============================================================================
# MUX_TOKEN_ID=
# MUX_TOKEN_SECRET=
# MUX_SIGNING_KEY_ID=
# MUX_PRIVATE_KEY=
# MUX_WEBHOOK_SECRET=

# ==============================================================================
# Security & JWT
# ==============================================================================
JWT_SECRET=
JWT_EXPIRATION=90d
JWT_EXPIRE_TIME=90d

# ==============================================================================
# Edge / Raspberry Pi Configuration
# ==============================================================================
# Device credentials. NEVER hardcode these in source — they are secrets that
# grant access to venue NVRs. Per-venue overrides use PI_<KIND>_API_KEY_<SLUG>
# where SLUG is one of: DEFAULT, BOTANICAL, COURT17, COURT11, PICKLEFLOW.
PI_API_KEY=
PI_EVMS_API_KEY=
PI_LIVE_API_KEY=
# Per-venue overrides (optional)
# PI_EVMS_API_KEY_BOTANICAL=
# PI_EVMS_API_KEY_COURT17=
# PI_EVMS_API_KEY_COURT11=
# PI_EVMS_API_KEY_PICKLEFLOW=
# PI_LIVE_API_KEY_BOTANICAL=
# PI_LIVE_API_KEY_PICKLEFLOW=
PI_LIVE_API_URL=
PI_RECORDINGS_API_URL=
RASPBERRY_PI_API_URL=
RPI_CLIENT_ID=
# Static-IP fallback used only when Tailscale DNS is unreachable from the VPC.
# PI_BOTANICAL_GATEWAY_IP=
# PI_COURT17_GATEWAY_IP=
# PI_COURT11_GATEWAY_IP=
# PI_PICKLEFLOW_GATEWAY_IP=

# ==============================================================================
# Extraction Queue (R2 / Cloudflare Stream pipeline)
# ==============================================================================
# Shared secret the venue Pi uses to sign callbacks:
#   x-pi-timestamp: <unix seconds>
#   x-pi-signature: hex HMAC-SHA256 of `${timestamp}.${rawBody}`
# The callback endpoint REJECTS unsigned requests unless
# PI_CALLBACK_REQUIRE_SIGNATURE is explicitly set to false (local dev only).
PI_CALLBACK_SECRET=
PI_CALLBACK_REQUIRE_SIGNATURE=true

# Extractions allowed in flight PER Pi gateway. Raise for more throughput;
# lower if a venue Pi/NVR saturates. Default 3.
EXTRACTION_CONCURRENCY_PER_PI=3
# A job in an active state for longer than this is treated as dead and retried.
# MUST exceed a full NVR-read + upload cycle for your largest clips. If this is
# shorter than a legitimate transfer, stale recovery kills the in-flight upload
# and restarts the whole extraction, which loops forever and looks like a total
# stall. Default 120 minutes.
EXTRACTION_STALE_AFTER_MS=7200000
# Grace period before re-dispatching after a TIMED-OUT trigger. The device may
# still be working; re-sending immediately would start a second full multi-GB
# extraction. Default 45 minutes.
EXTRACTION_UNKNOWN_OUTCOME_GRACE_MS=2700000

# How long the backend waits for the venue device to acknowledge an extraction
# trigger, per attempt. Default 30 minutes.
PI_EXTRACT_TRIGGER_TIMEOUT_MS=1800000
# TOTAL budget shared by the primary trigger and its fallback. The fallback only
# receives whatever is left, so a stuck device can never pin a worker for
# timeout x 2. Defaults to the per-attempt timeout.
PI_EXTRACT_TRIGGER_TOTAL_BUDGET_MS=1800000

# ------------------------------------------------------------------------------
# R2 multipart uploads (large NVR extractions)
# ------------------------------------------------------------------------------
# When the backend knows the object size, it hands the device a multipart plan:
# parallel part uploads where a failure retries only that part instead of
# restarting the whole file. Devices that do not understand the optional
# `multipart` block in the trigger payload keep using the single-shot URL.
# Part size must be >= 5 MiB (S3/R2 limit). Default 64 MiB.
R2_UPLOAD_PART_SIZE_BYTES=67108864
# Parallel part uploads per job. More parts in flight = better throughput on
# high-latency venue links, but more memory and bandwidth on the device.
# Default 3.
R2_UPLOAD_CONCURRENCY=3

# ==============================================================================
# Third-party Integrations
# ==============================================================================
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_APP_CHECK_DEBUG_TOKEN=
FIREBASE_PRIVATE_KEY=

GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_REDIRECT_URL=
GOOGLE_OAUTH_SECRET=

RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

FAST2SMS_AUTHORIZATION=
FAST2SMS_DLT_MESSAGE_ID=
FAST2SMS_SENDER_ID=

MSG91_AUTH_KEY=
MSG91_OTP_TEMPLATE_ID=

SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SUPPORT_CONTACT_TO=

TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

FFMPEG_PATH=/opt/bin/ffmpeg