# ---------------------------------------------------------------------------
# RDS Postgres 16 — Graviton t4g.micro, single-AZ, gp3. Isolated subnets,
# reachable only from the task SG. Password is generated by Terraform and
# mirrored into SSM (see ssm.tf) so it is injected into ECS as a secret.
# ---------------------------------------------------------------------------

resource "aws_db_subnet_group" "main" {
  name       = "${local.name_prefix}-db-subnets"
  subnet_ids = aws_subnet.isolated[*].id
  tags       = { Name = "${local.name_prefix}-db-subnets" }
}

resource "aws_db_parameter_group" "main" {
  name   = "${local.name_prefix}-pg16"
  family = "postgres16"

  # Log slow queries so a runaway query is visible without paid tooling.
  parameter {
    name  = "log_min_duration_statement"
    value = "1000"
  }
}

resource "aws_db_instance" "main" {
  identifier     = "${local.name_prefix}-db"
  engine         = "postgres"
  engine_version = "16"
  instance_class = var.db_instance_class

  allocated_storage     = var.db_allocated_storage
  max_allocated_storage = 100 # allow autoscaling storage up to 100GB
  storage_type          = "gp3"
  storage_encrypted     = true

  db_name  = var.db_name
  username = var.db_username
  password = random_password.db.result
  port     = 5432

  db_subnet_group_name   = aws_db_subnet_group.main.name
  vpc_security_group_ids = [aws_security_group.rds.id]
  parameter_group_name   = aws_db_parameter_group.main.name

  multi_az            = false
  publicly_accessible = false

  # Free-tier plan accounts can't set automated backups / PI / etc. When
  # db_free_tier is flipped off (after upgrading the account), these become
  # production-grade (7-day backups, PI, deletion protection, final snapshot).
  backup_retention_period = var.db_free_tier ? 0 : 7
  backup_window           = var.db_free_tier ? null : "18:30-19:00" # ~00:00 IST
  maintenance_window      = "Mon:19:30-Mon:20:30"

  auto_minor_version_upgrade = true
  deletion_protection        = var.db_free_tier ? false : true
  skip_final_snapshot        = var.db_free_tier ? true : false
  final_snapshot_identifier  = var.db_free_tier ? null : "${local.name_prefix}-db-final"

  performance_insights_enabled          = var.db_free_tier ? false : true
  performance_insights_retention_period = var.db_free_tier ? null : 7

  tags = { Name = "${local.name_prefix}-db" }
}
